#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

METAL_CPP_ROOT="${METAL_CPP_ROOT:-third_party/metal-cpp}"
OUT_DIR="${OUT_DIR:-build/metalenvpool-native}"

if [[ ! -f "$METAL_CPP_ROOT/Metal/Metal.hpp" ]]; then
  "$ROOT/scripts/fetch-metal-cpp" >/dev/null
fi

mkdir -p "$OUT_DIR"

uv run metalenvpool-build-native --output-dir "$OUT_DIR" >/dev/null

clang++ \
  -std=c++17 \
  -O3 \
  -DNDEBUG \
  -I"$METAL_CPP_ROOT" \
  -framework Foundation \
  -framework Metal \
  native/metalenvpool_atari_bench.cpp \
  -o "$OUT_DIR/metalenvpool_atari_bench"

printf '%s\n' "$OUT_DIR/metalenvpool_atari_bench"
